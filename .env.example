# Canonical origin used for canonical links, og:url, JSON-LD and the sitemap.
# Defaults to https://www.suhailsubair.online when unset (see nuxt.config.ts).
# The apex (suhailsubair.online) redirects to www, so www is the canonical origin.
# Set this per environment — a preview deploy should not claim the production URL.
NUXT_PUBLIC_SITE_URL=https://www.suhailsubair.online
